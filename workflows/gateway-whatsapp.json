    {
      "parameters": {
        "jsCode": "// Normalizar Payload (Meta & YCloud) con filtro anti-bucle estricto\nconst body = $json.body || {};\nlet customerPhone = null;\nlet messageText = null;\n\n// Caso 1: Evento de YCloud\nif (body.type) {\n  if (body.type !== 'whatsapp.inbound_message.received') {\n    return []; // Ignorar estados de entrega, plantillas, etc.\n  }\n  const msg = body.whatsappInboundMessage || {};\n  customerPhone = msg.from || (body.customer && body.customer.phoneNumber);\n  messageText = (msg.text && msg.text.body) ? msg.text.body : null;\n}\n// Caso 2: Evento directo de Meta Cloud API\nelse if (body.object === 'whatsapp_business_account' && body.entry) {\n  for (const entry of body.entry) {\n    for (const change of (entry.changes || [])) {\n      const val = change.value || {};\n      // Si es reporte de estado (entregado, leido, enviado), IGNORAR\n      if (val.statuses && val.statuses.length > 0) {\n        return [];\n      }\n      if (val.messages && val.messages.length > 0) {\n        const msg = val.messages[0];\n        customerPhone = msg.from;\n        if (msg.type === 'text' && msg.text) {\n          messageText = msg.text.body;\n        }\n      }\n    }\n  }\n}\n\n// Filtrar si el n?mero es el de nuestra propia l?nea (+573118849896)\nif (!customerPhone || !messageText || customerPhone.includes('3118849896')) {\n  return [];\n}\n\nif (!customerPhone.startsWith('+')) {\n  customerPhone = '+' + customerPhone;\n}\n\nreturn [{\n  json: {\n    customerPhone: customerPhone,\n    messageText: messageText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
