    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst normalizePhone = (value) => '+' + String(value || '').replace(/\\D/g, '');\nconst adminPhones = ['+573222046768', '+573027697381'];\nconst customerPhone = normalizePhone(input.customerPhone);\nconst messageText = String(input.messageText || '').trim();\nconst isAdminCommand = adminPhones.includes(customerPhone) && messageText.startsWith('#');\nreturn [{ json: { ...input, customerPhone, messageText, isAdminCommand } }];"
      },
