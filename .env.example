# =========================================================================
# CONFIGURACIÓN DE ENTORNO PARA GAFAS ANTIOQUIA - N8N
# =========================================================================

# Zona horaria del contenedor
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota

# URL pública de webhook de n8n.
# IMPORTANTE: Reemplaza esta URL con tu dirección de ngrok, localtunnel o VPS
# para que YCloud pueda enviar los webhooks correctamente a tu instancia local.
# Ejemplo: WEBHOOK_URL=https://mi-tunel.ngrok-free.app/
WEBHOOK_URL=http://localhost:5678/
